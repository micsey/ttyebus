#!/bin/bash

# ==============================================================================
# ttyebus Configure Script v2.0
# Ermittelt Modell und IRQ für RPi 3/4 unter Bookworm (Kernel 6.x)
# ==============================================================================

echo "Prüfe Raspberry Pi Hardware..."

# 1. Bestimmung des Modells über den Device-Tree
# ------------------------------------------------------------------------------
MODEL_STR=$(tr -d '\0' < /proc/device-tree/model)
RASPI_MODEL=0

if [[ "$MODEL_STR" == *"Raspberry Pi 4"* ]]; then
    RASPI_MODEL=4
    echo "Gefunden: Raspberry Pi 4"
elif [[ "$MODEL_STR" == *"Raspberry Pi 3"* ]]; then
    RASPI_MODEL=3
    echo "Gefunden: Raspberry Pi 3"
elif [[ "$MODEL_STR" == *"Raspberry Pi 2"* ]]; then
    RASPI_MODEL=2
    echo "Gefunden: Raspberry Pi 2"
else
    echo "WARNUNG: Unbekanntes Modell ($MODEL_STR). Setze Standard auf RPi 3/4 Kompatibilität."
    RASPI_MODEL=3
fi

# 2. Bestimmung des Interrupts (IRQ) für ttyAMA0
# ------------------------------------------------------------------------------
# Unter Bookworm/Kernel 6.x nutzen wir /proc/interrupts, um den aktiven IRQ zu finden.
# Wir suchen nach dem Handler für 'uart-pl011' oder 'ttyAMA0'.
UART_IRQ=$(grep -m 1 "uart-pl011" /proc/interrupts | awk '{print $1}' | tr -d ':')

# Falls über 'uart-pl011' nichts gefunden wurde (z.B. Treiber nicht geladen),
# versuchen wir es über den Device Tree direkt.
if [ -z "$UART_IRQ" ]; then
    UART_IRQ=$(grep -m 1 "ttyAMA0" /proc/interrupts | awk '{print $1}' | tr -d ':')
fi

# Falls beides schief geht, hilft dmesg
if [ -z "$UART_IRQ" ]; then
    UART_IRQ=$(dmesg | grep ttyAMA0 | grep -oP 'irq\s*=\s*\K\d+')
fi

# Letzter Versuch, wenn ttyebus schon aktiv ist
if [ -z "$UART_IRQ" ]; then
    UART_IRQ=$(grep -m 1 "ttyebus" /proc/interrupts | awk '{print $1}' | tr -d ':')
fi

if [ -z "$UART_IRQ" ]; then
    echo "FEHLER: Konnte IRQ für ttyAMA0 nicht ermitteln!"
    exit 1
fi

echo "Gefundener IRQ: $UART_IRQ"

# 3. Erstellung der Compiler-Flags
# ------------------------------------------------
# Wir schreiben die Werte in eine Datei 'config.h',
# die vom C-Code eingebunden wird.

cat << EOF > config.h
/* Automatisch generiert durch configure am $(date) */
#ifndef MODEL_VAL
#define MODEL_VAL $RASPI_MODEL
#endif

#ifndef IRQ_VAL
#define IRQ_VAL $UART_IRQ
#endif
EOF

echo "Konfiguration abgeschlossen. 'config.h' wurde erstellt."
